# Environment template — PLACEHOLDER values only. Never commit real secrets (Constitution Art. VI).
# Copy to `.env` (git-ignored) and fill in real values locally. `.env` is NOT tracked.
# These names are illustrative for later phases (5+); the exact set may evolve. No runtime is
# committed to in Phase 2 — this is a scaffold placeholder.

# --- Azure AI Foundry ---
# Foundry project endpoint (Overview page of the project). Used by agent/harness.py + eval/.
# Phase-5 live value (infra, committable per narrowed Art. VI):
#   https://tchack-resource.services.ai.azure.com/api/projects/tchack
FOUNDRY_PROJECT_ENDPOINT=<placeholder-foundry-project-endpoint>
# The Fabric IQ (OneLake Catalog) PROJECT CONNECTION for the fabric_iq_preview tool. REQUIRED.
# Created once in the Foundry portal (managed OAuth; needs Foundry Project Manager). This is the
# connection id/name, NOT a secret token — but it is environment-specific, so keep it in .env.
FABRIC_IQ_PROJECT_CONNECTION_ID=<placeholder-fabric-iq-connection-id>
# Name of the deployed model deployment the hosted agent references (swappable — Art. III).
# The H1 matrix uses gpt-5.4 (LLM) and gpt-5.4-mini (SLM), both deployed on tchack-resource (eastus2).
FOUNDRY_MODEL_DEPLOYMENT_NAME=<placeholder-model-deployment-name>

# --- Microsoft Fabric ---
# Fabric workspace GUID that hosts the ontology item and its bound OneLake sources.
FABRIC_WORKSPACE_ID=<placeholder-fabric-workspace-id>
# Lakehouse GUID holding the flat managed Delta tables the ontology binds to.
# Leave blank to have scripts/load_lakehouse.py create a new Lakehouse (Phase 4);
# it defaults to display name `iqnpl_lakehouse` (override with --lakehouse-name).
FABRIC_LAKEHOUSE_ID=<placeholder-fabric-lakehouse-id>
# Ontology (preview) item GUID within the workspace (target of scripts/deploy_ontology.py).
FABRIC_ONTOLOGY_ITEM_ID=<placeholder-ontology-item-id>
# Companion GraphModel item GUID (auto-created with the ontology). scripts/build_graph_model.py
# resolves this automatically from the ontology id; set only to override.
FABRIC_GRAPH_ITEM_ID=<placeholder-graph-item-id>
# OneLake schema folder under Tables/ for the graph data sources. Empty for a non-schema Lakehouse
# (how load_lakehouse.py writes managed tables); use `dbo` for a schema-enabled Lakehouse.
FABRIC_TABLE_SCHEMA=

