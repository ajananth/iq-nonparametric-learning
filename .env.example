# Environment template — PLACEHOLDER values only. Never commit real secrets (Constitution Art. VI).
# Copy to `.env` (git-ignored) and fill in real values locally. `.env` is NOT tracked.
# These names are illustrative for later phases (5+); the exact set may evolve. No runtime is
# committed to in Phase 2 — this is a scaffold placeholder.

# --- Azure AI Foundry ---
# The Fabric IQ project connection id used by the fabric_iq_preview tool (project_connection_id).
FOUNDRY_PROJECT_CONNECTION_ID=<placeholder-foundry-project-connection-id>
# Name of the deployed GPT-5-family model deployment the hosted agent references.
FOUNDRY_MODEL_DEPLOYMENT_NAME=<placeholder-model-deployment-name>

# --- Microsoft Fabric ---
# Fabric workspace GUID that hosts the ontology item and its bound OneLake sources.
FABRIC_WORKSPACE_ID=<placeholder-fabric-workspace-id>
# Lakehouse GUID holding the flat managed Delta tables the ontology binds to.
# Leave blank to have scripts/load_lakehouse.py create a new Lakehouse (Phase 4).
FABRIC_LAKEHOUSE_ID=<placeholder-fabric-lakehouse-id>
# Ontology (preview) item GUID within the workspace (target of scripts/deploy_ontology.py).
FABRIC_ONTOLOGY_ITEM_ID=<placeholder-ontology-item-id>
